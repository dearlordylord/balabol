module VoiceOutputTest {
  import basicSpells.* from "./spells/basicSpells"
  import VoiceOutputCore.* from "./VoiceOutput"
  import VoiceOutputMachine(oldGate = false, reactivate = false).* from "./VoiceOutput"
  run interruptedTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: None, pending: List()})))
    .then(observeEvent(1, value(X, Interrupted))).expect(safety)
    .then(observeEvent(2, value(X, Playing))).expect(safety)
  run deliveredTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: Some(2), pending: List()})))
    .then(observeEvent(1, value(X, Delivered))).expect(safety)
  run failedTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: None, pending: List()})))
    .then(observeEvent(1, value(X, Failed))).expect(safety)
  run replacementTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Audio(X))).then(deliver(Accept(1)))
    .then(deliver(Cut({nextInput: None, pending: List(1, 2, 1)})))
    .then(deliver(Accept(1))).then(observeEvent(1, value(Y, Playing)))
    .then(deliver(Accept(2))).then(deliver(Cut({nextInput: Some(2), pending: List()})))
    .then(observeEvent(2, value(Y, AwaitingReady))).expect(state.prepared == Some(Y))
    .then(observeEvent(3, value(X, Interrupted))).expect(identity(state.current) == Some(Y))
    .then(deliver(Fail(X))).then(deliver(Fail(Y))).then(deliver(Disconnect))
  run epochAndFreshnessTest = init.then(observeEvent(0, value(X, Playing)))
    .then(observeEvent(0, value(Y, Playing))).expect(identity(state.current) == Some(X))
    .then(observeEvent(1, value(X, AwaitingReady))).expect(state.current == Some(value(X, Playing)))
    .then(observeEvent(2, value(Z, Playing))).expect(state.prepared == Some(Z))
    .then(deliver(Audio(X))).expect(not(state.receivedAudio))
    .then(deliver(Audio(Z))).expect(state.receivedAudio)
  run interruptedOtherAllowedTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: Some(2), pending: List()})))
    .then(observeEvent(1, value(X, Interrupted))).expect(safety)
  run deliveredAbsentAllowedTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: None, pending: List()})))
    .then(observeEvent(1, value(X, Delivered))).expect(safety)
  run failedOtherAllowedTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: Some(2), pending: List()})))
    .then(observeEvent(1, value(X, Failed))).expect(safety)
  run freshAcceptedInputTest = init.then(observeEvent(0, value(X, Preparing)))
    .then(deliver(Accept(1))).then(deliver(Cut({nextInput: None, pending: List(1)})))
    .then(deliver(Accept(1))).expect(state.allowedInput == None)
    .then(deliver(Accept(2))).expect(state.allowedInput == Some(2))
    .then(observeEvent(1, value(Y, AwaitingReady))).expect(state.prepared == Some(Y) and commands.length() == 1)
  run closedAndWrongIdentityTest = init.then(observeEvent(0, value(X, Playing)))
    .then(deliver(Cut({nextInput: None, pending: List()})))
    .then(observeEvent(1, value(Z, Interrupted))).expect(identity(state.current) == Some(X))
    .then(observeEvent(2, value(X, Interrupted)))
    .then(deliver(Disconnect)).then(observeEvent(3, value(Y, Playing))).expect(state.current == None)
  run deliveredCannotReactivateWithoutGateTest = init
    .then(observeEvent(0, value(X, Playing)))
    .then(observeEvent(1, value(X, Delivered)))
    .then(observeEvent(2, value(X, Playing))).expect(safety)
  run interruptedCannotReactivateWithoutGateTest = init
    .then(observeEvent(0, value(X, Playing)))
    .then(observeEvent(1, value(X, Interrupted)))
    .then(observeEvent(2, value(X, Playing))).expect(safety)
  run failedCannotReactivateWithoutGateTest = init
    .then(observeEvent(0, value(X, Playing)))
    .then(observeEvent(1, value(X, Failed)))
    .then(observeEvent(2, value(X, Playing))).expect(safety)
}
