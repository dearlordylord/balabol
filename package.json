{
  "name": "@firfi/balabol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "check-format": "prettier --check . && node scripts/quality/cli.mjs format",
    "format": "prettier --write . && dprint fmt --allow-no-files",
    "secrets:staged": "gitleaks git --pre-commit --staged --redact --ignore-gitleaks-allow --no-banner",
    "secrets:files": "gitleaks dir --redact --ignore-gitleaks-allow --no-banner .",
    "secrets:history": "gitleaks git --redact --ignore-gitleaks-allow --no-banner .",
    "check:repository": "pnpm check-format && pnpm secrets:staged",
    "build": "node scripts/quality/cli.mjs build",
    "typecheck": "pnpm typecheck:tsc && pnpm typecheck:effect",
    "typecheck:tsc": "node scripts/quality/cli.mjs compiler",
    "typecheck:effect": "node scripts/quality/cli.mjs effect",
    "test": "node scripts/quality/cli.mjs behavior",
    "test:coverage": "node scripts/quality/cli.mjs behavior",
    "test:harness": "node --test scripts/quality/cli.test.mjs",
    "lint": "node scripts/quality/cli.mjs lint && node scripts/quality/cli.mjs duplication",
    "circular": "node scripts/quality/cli.mjs architecture && node scripts/quality/cli.mjs cycles",
    "complexity": "node scripts/quality/cli.mjs complexity",
    "check-all": "pnpm secrets:files && pnpm test:harness && node scripts/quality/cli.mjs all && pnpm check-format",
    "verify:effect-cohort": "node scripts/quality/cli.mjs cohort",
    "start": "node dist/bootstrap/main.js",
    "dev:voice": "node scripts/dev-voice.mjs",
    "subscription": "pnpm build && node dist/bootstrap/subscription-main.js"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": "prettier --write",
    "*.ts": [
      "oxlint -c .oxlintrc.json --fix --deny-warnings",
      "dprint fmt --allow-no-files"
    ]
  },
  "devDependencies": {
    "@crap4ts/crap4ts": "1.1.0",
    "@effect/platform-node": "4.0.0",
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "4.0.0",
    "@types/node": "25.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "dpdm": "4.2.0",
    "dprint": "0.55.2",
    "effect": "4.0.0",
    "fast-check": "4.8.0",
    "husky": "9.1.7",
    "jscpd": "4.0.8",
    "lint-staged": "16.2.7",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.6.2",
    "typescript-compiler-api": "npm:typescript@5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "dprint"
    ],
    "patchedDependencies": {
      "@firfi/unii@0.1.0": "patches/@firfi__unii@0.1.0.patch"
    }
  },
  "dependencies": {
    "@firfi/unii": "0.1.0",
    "@livekit/rtc-node": "1.1.0",
    "jose": "6.2.12",
    "livekit-server-sdk": "2.19.1"
  }
}
